# Emulator mode (npm run dev:emulator / npm run build:emulator): everything local under the
# demo-turnagain project id that firebase.json singleProjectMode expects (spec 12.2); the id itself
# is EMULATOR_PROJECT_ID in src/firebase/firebaseConfig.js, so no VITE_ variable carries it.
VITE_USE_EMULATORS=1
VITE_FUNCTIONS_TARGET=emulator
