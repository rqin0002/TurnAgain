{
  "name": "turnagain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "vite build",
    "build:emulator": "vite build --mode emulator",
    "preview": "vite preview",
    "seed": "node --import ./seed/lib/register.mjs seed/seed.mjs",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "oxlint . && eslint . --cache",
    "format": "prettier --write --experimental-cli src/ tests/ functions/ seed/",
    "test": "vitest run",
    "test:api": "firebase emulators:exec --only auth,firestore --project demo-turnagain \"vitest run --config tests/api/vitest.config.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-turnagain \"vitest run --config tests/rules/vitest.config.js\"",
    "test:e2e": "playwright test",
    "test:e2e:emulators": "firebase emulators:exec --only auth,firestore,functions --project demo-turnagain \"playwright test\"",
    "functions:dev": "firebase emulators:start --only functions",
    "emulators": "firebase emulators:start --only auth,firestore,functions --project demo-turnagain",
    "deploy:backend": "firebase deploy --only functions,firestore:rules,firestore:indexes",
    "check": "run-s lint:check test build"
  },
  "dependencies": {
    "@fullcalendar/vue3": "7.1.0",
    "animejs": "^4.5.0",
    "chart.js": "4.5.1",
    "express": "^5.2.1",
    "firebase": "12.19.0",
    "leaflet": "^1.9.4",
    "pinia": "^4.0.3",
    "temporal-polyfill": "1.0.5",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "2.5.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.79.0",
    "eslint-plugin-vue": "~10.11.1",
    "globals": "^17.7.0",
    "jsdom": "30.1.2",
    "npm-run-all2": "^9.0.2",
    "oxlint": "^1.79.0",
    "prettier": "3.9.9",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "5.0.3",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "@firebase/firestore@4.17.2": {
      "@grpc/grpc-js": "1.14.5"
    }
  }
}
